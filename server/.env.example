# ---------------------------------------------------------------------------
# Server configuration
# Copy this file to `.env` and fill in the real values.
# Never put real keys in this file — it is committed to version control.
# ---------------------------------------------------------------------------

# Port the Express API listens on (the Vite dev server proxies /api here).
# 5000 is avoided: macOS AirPlay Receiver already listens there.
PORT=5001

# "development" | "production"
NODE_ENV=development

# Origin of the React client. Used for CORS in development.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string from your MongoDB Atlas project
MONGODB_URI=<YOUR_MONGODB_URI>

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# OAuth 2.0 Web Client ID from Google Cloud Console (same value as the client)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# Long random string used to sign session JWTs, e.g. `openssl rand -hex 64`
JWT_SECRET=<YOUR_JWT_SECRET>

# How long a session stays valid
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# AI Habit Coach (Google Gemini)
# ---------------------------------------------------------------------------
# API key from Google AI Studio
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Model used for coaching replies
GEMINI_MODEL=gemini-3.6-flash
