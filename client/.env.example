# ---------------------------------------------------------------------------
# Client configuration
# Copy this file to `.env` and fill in the real values.
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put real keys in this file — it is committed to version control.
# ---------------------------------------------------------------------------

# OAuth 2.0 Web Client ID from Google Cloud Console (same value as the server).
# Add http://localhost:5173 to the client's "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# Where the Vite dev server proxies /api requests. Leave as-is for local dev.
VITE_API_PROXY_TARGET=http://localhost:5001

# Base URL for API calls. Keep "/api" locally so the dev proxy is used; set it
# to the deployed API origin (e.g. https://your-api.onrender.com/api) in production.
VITE_API_BASE_URL=/api
